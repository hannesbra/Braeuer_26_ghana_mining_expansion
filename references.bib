@article{koerting2024VNIRSWIR,
  title = {{{VNIR-SWIR Imaging Spectroscopy}} for {{Mining}}: {{Insights}} for {{Hyperspectral Drone Applications}}},
  shorttitle = {{{VNIR-SWIR Imaging Spectroscopy}} for {{Mining}}},
  author = {Koerting, Friederike and Asadzadeh, Saeid and Hildebrand, Justus Constantin and Savinova, Ekaterina and Kouzeli, Evlampia and Nikolakopoulos, Konstantinos and Lindblom, David and Koellner, Nicole and Buckley, Simon J. and Lehman, Miranda and Schl{\"a}pfer, Daniel and Micklethwaite, Steven},
  year = 2024,
  month = nov,
  journal = {Mining},
  volume = {4},
  number = {4},
  pages = {1013--1057},
  issn = {2673-6489},
  doi = {10.3390/mining4040057},
  urldate = {2025-10-13},
  abstract = {Hyperspectral imaging technology holds great potential for various stages of the mining life cycle, both in active and abandoned mines, from exploration to reclamation. The technology, however, has yet to achieve large-scale industrial implementation and acceptance. While hyperspectral satellite imagery yields high spectral resolution, a high signal-to-noise ratio (SNR), and global availability with breakthrough systems like EnMAP, EMIT, GaoFen-5, PRISMA, and Tanager1, limited spatial and temporal resolution poses challenges for the mining sectors, which require decimetre-to-centimetre-scale spatial resolution for applications such as reconciliation and environmental monitoring and daily temporal revisit times, such as for ore/waste estimates and geotechnical assessments. Hyperspectral imaging from drones (Uncrewed Aerial Systems; UASs) offers highspatial-resolution data relevant to the pit/mine scale, with the capability for frequent, user-defined re-visit times for areas of limited extent. Areas of interest can be defined by the user and targeted explicitly. Collecting data in the visible to near and shortwave infrared (VNIR-SWIR) wavelength regions offers the detection of different minerals and surface alteration patterns, potentially revealing crucial information for exploration, extraction, re-mining, waste remediation, and rehabilitation. This is related to but not exclusive to detecting deleterious minerals for different processes (e.g., clays, iron oxides, talc), secondary iron oxides indicating the leakage of acid mine drainage for rehabilitation efforts, swelling clays potentially affecting rock integrity and stability, and alteration minerals used to vector toward economic mineralisation (e.g., dickite, jarosite, alunite). In this paper, we review applicable instrumentation, software components, and relevant studies deploying hyperspectral imaging datasets in or appropriate to the mining sector, with a particular focus on hyperspectral VNIR-SWIR UASs. Complementarily, we draw on previous insights from airborne, satellite, and ground-based imaging systems. We also discuss common practises for UAS survey planning and ground sampling considerations to aid in data interpretation.},
  langid = {english},
  file = {C:\Users\hanne\Zotero\storage\APVMNKSJ\Koerting et al. - 2024 - VNIR-SWIR Imaging Spectroscopy for Mining Insights for Hyperspectral Drone Applications.pdf}
}

@article{koot2025Intimidation,
  title = {Intimidation as Epistemological Violence against Social Science Conservation Research},
  author = {Koot, Stasja and Anyango-van Zwieten, Nowella and Sullivan, Sian and Dressler, Wolfram and Spierenburg, Marja and Trogisch, Lisa and Marijnen, Esther and Fletcher, Robert and Rakhmani, Inaya and Abdulwahab Afiff, Suraya and Benjaminsen, Tor A. and Milne, Sarah and Svarstad, Hanne and B{\"u}scher, Bram and Dutta, Anwesha and Lowe, Celia and Rai, Nitin D.},
  year = 2025,
  month = apr,
  journal = {Conservation Biology},
  volume = {39},
  number = {2},
  pages = {1--9},
  issn = {0888-8892, 1523-1739},
  doi = {10.1111/cobi.14454},
  urldate = {2026-01-07},
  abstract = {Abstract                            We investigated intimidation of conservation social scientists, which is ongoing and aimed at silencing or discrediting research findings. Although social scientists share with conservation biologists the desire to understand and address the biodiversity crisis, their analysis of structural power relations and contradictions in conservation is sometimes not appreciated. Intimidation can take place before and during fieldwork, during the publication process, and after publication in academic and public spheres. We examined our diverse experiences of intimidation, including legal threats, character assassination, physical threats, job exclusion, and curtailment of academic freedom. Diverse actors, including national research granting bodies, international policy makers, donors, ethics bodies, and conservation biologists and organizations, may target research that does not align with their political, economic, financial, and ideological interests. We refer to intimidating practices to suppress or alter unwelcome perspectives or research findings as               epistemological violence               . Tactics of epistemological violence relate to structural, systemic, symbolic, discursive, and material violence and have significant implications for understanding and improving long-term conservation. Epistemological violence can impede the progress, effectiveness, and social justness of conservation and suppress critical or differently informed perspectives crucial for a well-functioning academia. Intimidation hampers crucial collaborations among disciplines and with societal partners. Epistemological violence has detrimental consequences for affected individuals, the broader conservation community, people living in or near conservation areas, and conservation achievements.                        ,                                            La intimidaci\'on como violencia epistemol\'ogica contra la investigaci\'on de las ciencias sociales de la conservaci\'on                                Resumen                 Investigamos la intimidaci\'on de los cient\'ificos sociales de la conservaci\'on, que es continua y tiene como objetivo silenciar o desacreditar los resultados de la investigaci\'on. Aunque los cient\'ificos sociales comparten con los bi\'ologos de la conservaci\'on el deseo de comprender y abordar la crisis de la biodiversidad, a veces no se aprecia su an\'alisis de las relaciones estructurales de poder y las contradicciones en la conservaci\'on. La intimidaci\'on puede producirse antes y durante el trabajo de campo, durante el proceso de publicaci\'on y despu\'es de la publicaci\'on el \'ambito acad\'emico y p\'ublico. Analizamos nuestras diversas experiencias de intimidaci\'on, incluidas las amenazas legales, la difamaci\'on, las amenazas f\'isicas, la exclusi\'on laboral y el recorte de la libertad acad\'emica. Diversos actores, entre ellos los organismos nacionales que conceden ayudas a la investigaci\'on, los responsables pol\'iticos internacionales, los donantes, los organismos de \'etica y los bi\'ologos y organizaciones conservacionistas, pueden poner en el punto de mira la investigaci\'on que no se ajusta a sus intereses pol\'iticos, econ\'omicos, financieros e ideol\'ogicos. Nos referimos a las pr\'acticas intimidatorias para suprimir o alterar perspectivas o resultados de investigaci\'on no deseados como violencia epistemol\'ogica. Las t\'acticas de violencia epistemol\'ogica est\'an relacionadas con la violencia estructural, sist\'emica, simb\'olica, discursiva y material, y tienen importantes implicaciones para comprender y mejorar la conservaci\'on a largo plazo. La violencia epistemol\'ogica puede impedir el progreso, la eficacia y la justicia social de la conservaci\'on y suprimir las perspectivas cr\'iticas o informadas de forma diferente, cruciales para el buen funcionamiento del mundo acad\'emico. La intimidaci\'on obstaculiza colaboraciones cruciales entre disciplinas y con interlocutores sociales. La violencia epistemol\'ogica tiene consecuencias perjudiciales para las personas afectadas, la comunidad conservacionista en general, las personas que viven en zonas de conservaci\'on o cerca de ellas y los logros de la conservaci\'on.},
  langid = {english},
  file = {C:\Users\hanne\Zotero\storage\V24X7TFG\Koot et al. - 2025 - Intimidation as epistemological violence against social science conservation research.pdf}
}

