@article{suglo2021Effects,
  title = {Effects of {{Illegal Mining}} on the {{Environment}}, {{Economy}}, and {{Agricultural Productivity}}},
  author = {Suglo, Peter and Effah, Paul and Amponsah Acheampong, Alfred and Sunkari, Raymond and Yeboah, Anthony},
