  file = {C\:\\Users\\hanne\\Zotero\\storage\\VZGQEVK3\\Beck and Katz - 2006 - 8. Nathaniel Beck and Jonathan N. Katz. 1995. “Wha.pdf;C\:\\Users\\hanne\\Zotero\\storage\\844CC9AG\\51CADF0BB62E410EF0E591F3D11DA6A2.html;C\:\\Users\\hanne\\Zotero\\storage\\H6S4L54E\\51CADF0BB62E410EF0E591F3D11DA6A2.html}
