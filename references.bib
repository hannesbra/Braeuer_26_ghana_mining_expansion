@article{shen2022bidirectional,
  title = {A Bi-Directional Strategy to Detect Land Use Function Change Using Time-Series {{Landsat}} Imagery on {{Google Earth Engine}}: {{A}} Case Study of {{Huangshui River Basin}} in {{China}}},
  shorttitle = {A Bi-Directional Strategy to Detect Land Use Function Change Using Time-Series {{Landsat}} Imagery on {{Google Earth Engine}}},
  author = {Shen, Zhenyu and Wang, Yafei and Su, Han and He, Yao and Li, Shuang},
  year = 2022,
