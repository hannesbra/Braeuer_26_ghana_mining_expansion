@article{mensah2025Subaltern,
  title = {Subaltern Environmentalism and Small-Scale Mining Reforms in {{Ghana}}: The New Government's Five-Point Strategy and a Model for Mining Site Reclamation},
  shorttitle = {Subaltern Environmentalism and Small-Scale Mining Reforms in {{Ghana}}},
  author = {Mensah, Albert Kobina and Tuokuu, Francis Xavier Dery},
  year = 2025,
